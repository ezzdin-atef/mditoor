{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mditoor",
  "version": "../package.json",
  "identifier": "com.ezzeldingomaa.mditoor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mditoor — MDX Content Studio",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyQkE3MUFEMDZDNjQ2OTIKUldTU1JzWUdyWEc2NGtqZWVOUitJRFYvU000QUxjeTBHMDg0SnN0b2dqS1NrUnVpVHkyY01WRkIK",
      "endpoints": [
        "https://github.com/ezzdin-atef/mditoor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
